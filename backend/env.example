# Crypto Trade Backend Environment Variables

# API Settings
API_V1_STR=/api/v1
PROJECT_NAME=Crypto Trade Backend
VERSION=1.0.0
HOST=0.0.0.0
PORT=8000
DEBUG=true

# CORS Settings (comma-separated list)
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001

# Firebase Configuration
# Get these from your Firebase project settings -> Service accounts
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PRIVATE_KEY_ID=your-private-key-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
FIREBASE_CLIENT_ID=your-client-id
FIREBASE_CLIENT_X509_CERT_URL=https://www.googleapis.com/robot/v1/metadata/x509/your-service-account%40your-project.iam.gserviceaccount.com
FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com/

# Binance API Configuration
# Get these from your Binance account -> API Management
BINANCE_API_KEY=your-binance-api-key
BINANCE_SECRET_KEY=your-binance-secret-key
BINANCE_TESTNET=true

# ML Service Configuration
ML_SERVICE_URL=http://localhost:5000
ML_MODEL_VERSION=v1.0

# Redis Configuration (optional, for caching)
REDIS_URL=redis://localhost:6379
